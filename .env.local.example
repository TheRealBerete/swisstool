# Copie ce fichier en .env.local et renseigne tes clés Supabase
# (Project Settings > API dans le dashboard Supabase).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel — module Téléchargeur (src/lib/lotus/client.ts). Laisse
# commenté : la valeur par défaut (https://api.lotusvids.online) suffit,
# à changer seulement si le fournisseur change de domaine.
# LOTUS_API_BASE_URL=https://api.lotusvids.onlinex
