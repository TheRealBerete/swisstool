# Copie ce fichier en .env.local et renseigne tes clés Supabase
# (Project Settings > API dans le dashboard Supabase).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Module Téléchargeur — provider RapidAPI "social-download-all-in-one"
# (Instagram, TikTok, Facebook, X/Twitter). Clé obligatoire : compte sur
# rapidapi.com, quota mensuel selon le plan (voir README §Sécurité).
RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RAPIDAPI_HOST=social-download-all-in-one.p.rapidapi.com

# Module Téléchargeur — provider VidsSave (YouTube uniquement). API
# interne non-officielle : le jeton "auth" est public (visible dans le JS
# de vidssave.com, pas un secret personnel) mais peut changer sans
# préavis côté fournisseur. Laisse commenté sauf si le jeton change.
# VIDSSAVE_AUTH=20250901majwlqo
# VIDSSAVE_DOMAIN=api-ak.vidssave.com
